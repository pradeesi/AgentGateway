# ==============================================================================
# Purpose: Template environment configuration for the Cymbal Bank Google Cloud
#          Agent Gateway Defense-in-Depth Demo.
# Architecture/Context: Copy to `.env` for local overrides or let `./install.sh`
#          populate `.state/<PROJECT_ID>.outputs` dynamically during GCP setup.
#          Contains zero hardcoded secrets or real project identifiers.
# Dependencies/Side Effects: Read by provisioning scripts, Cloud Run services,
#          and ADK agents when `.env` is present.
# Author: Pradeep Singh
# License: Apache-2.0
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Cloud Target Environment
# ------------------------------------------------------------------------------
PROJECT_ID=your-gcp-project-id
REGION=us-central1
PREFIX=cbgw

# ------------------------------------------------------------------------------
# Vertex AI & Gemini Model Settings
# ------------------------------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_LOCATION=us-central1
MODEL_NAME=gemini-2.5-flash

# ------------------------------------------------------------------------------
# Backing Storage Layer (firestore | local)
# ------------------------------------------------------------------------------
STORAGE_BACKEND=local
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION_PREFIX=cymbal_agw
LOCAL_LEDGER_PATH=.local_data/cymbal_ledger.json

# ------------------------------------------------------------------------------
# MCP Server & Unregistered Rogue Endpoint Configuration
# ------------------------------------------------------------------------------
MCP_SERVER_URL=http://127.0.0.1:8081
MCP_READONLY_PATH=/mcp/readonly
MCP_PRIVILEGED_PATH=/mcp/privileged
MCP_UNIFIED_PATH=/mcp
MCP_AUTH_MODE=none
MCP_TIMEOUT_SECONDS=30
ROGUE_WEBHOOK_URL=http://127.0.0.1:8082/collect

# ------------------------------------------------------------------------------
# Agent Gateway, IAP / IAM UAP, Model Armor & Semantic Governance
# ------------------------------------------------------------------------------
IAP_ENFORCEMENT_MODE=ENFORCED
MODEL_ARMOR_PI_CONFIDENCE=LOW_AND_ABOVE
SDP_MIN_LIKELIHOOD=POSSIBLE
SGP_MAX_REFUND_USD=500
SGP_SUPERVISOR_CODE=SUP-APR-8841
SGP_DNS_ZONE_SUFFIX=sgp.cymbal.internal.

# ------------------------------------------------------------------------------
# Agent Gateway Token Management Policies (Aggregation, Budget & Cost-Per-Token)
# ------------------------------------------------------------------------------
TOKEN_MANAGEMENT_MODE=HYBRID_GATEWAY_PREVIEW
TM_SANDBOX_MAX_TOKENS=6000
TM_SHARED_OPS_MAX_TOKENS=50000
TM_SPECIALIST_MAX_TOKENS=100000
TM_DEFAULT_MAX_TOKENS=25000
TM_INPUT_TOKEN_COST_USD=0.00000015
TM_OUTPUT_TOKEN_COST_USD=0.00000060
TM_CACHED_TOKEN_COST_USD=0.0000000375
TM_PRO_COST_DISCOUNT=0.20

# ------------------------------------------------------------------------------
# Cymbal Bank Operations Portal Settings
# ------------------------------------------------------------------------------
PORTAL_PORT=8080
AGENT_INVOCATION_MODE=local
TIER1_REASONING_ENGINE=
SPECIALIST_REASONING_ENGINE=
LOG_LEVEL=INFO
